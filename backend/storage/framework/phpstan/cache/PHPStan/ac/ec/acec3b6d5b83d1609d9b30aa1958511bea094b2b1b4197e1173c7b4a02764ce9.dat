 * Scan the members of a sorted set incrementally, using a cursor
 *
 * @param string          $key      The sorted set to scan.
 * @param int|string|null $iterator A reference to an iterator that should be initialized to NULL initially, that
 *                                  will be updated after each subsequent call to ZSCAN.  Once the iterator
 *                                  has returned to zero the scan is complete
 * @param string|null     $pattern  An optional glob-style pattern that limits which members are returned during
 *                                  the scanning process.
 * @param int             $count    A hint for Redis that tells it how many elements it should test before returning
 *                                  from the call.  The higher the more work Redis may do in any one given call to
 *                                  ZSCAN potentially blocking for longer periods of time.
 *
 * @return Redis|array|false An array of elements or false on failure.
 *
 * @see https://redis.io/docs/latest/commands/zscan/
 * @see https://redis.io/docs/latest/commands/scan/
 * @see Redis::scan()
 *
 * NOTE:  See Redis::scan() for detailed example code on how to call SCAN like commands.
 *
 * @example
 * $it = null;
 * while ($members = $redis->zscan('leaders', $it)) {
 *     foreach ($members as $member => $score) {
 *         printf('%s => %s' . PHP_EOL, $member, $score);
 *     }
 * }
 */";s:9:"startLine";i:5690;s:7:"endLine";i:5692;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:6:"zunion";a:20:{s:4:"name";s:6:"zunion";s:10:"parameters";a:3:{s:4:"keys";a:13:{s:4:"name";s:4:"keys";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:5728;s:7:"endLine";i:5728;s:11:"startColumn";i:32;s:9:"endColumn";i:42;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:7:"weights";a:13:{s:4:"name";s:7:"weights";s:7:"default";a:2:{s:4:"code";s:5:"\null";s:10:"attributes";a:6:{s:9:"startLine";i:5728;s:7:"endLine";i:5728;s:13:"startTokenPos";i:10531;s:12:"startFilePos";i:248599;s:11:"endTokenPos";i:10531;s:10:"endFilePos";i:248602;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:5728;s:7:"endLine";i:5728;s:11:"startColumn";i:45;s:9:"endColumn";i:66;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}s:7:"options";a:13:{s:4:"name";s:7:"options";s:7:"default";a:2:{s:4:"code";s:5:"\null";s:10:"attributes";a:6:{s:9:"startLine";i:5728;s:7:"endLine";i:5728;s:13:"startTokenPos";i:10541;s:12:"startFilePos";i:248623;s:11:"endTokenPos";i:105