 * Creates a BigNumber of the given string, limiting the allowed syntax and the number of digits, or returns null
 * if the input is null.
 *
 * Behaves like {@see parse()} for non-null values.
 *
 * @param string|null        $value         The untrusted value to parse, or null.
 * @param list<NumberSyntax> $allowedSyntax The allowed syntax features; plain integers are always accepted.
 * @param positive-int       $maxDigits     The maximum number of digits, as written and in the resulting number.
 *
 * @throws NumberFormatException      If the format of $value is invalid, if it uses a syntax that is not allowed
 *                                    by $allowedSyntax, or if it has more than $maxDigits digits.
 * @throws RoundingNecessaryException If the method is called on a subclass of BigNumber, and the value cannot be
 *                                    converted to an instance of the subclass without rounding.
 * @throws InvalidArgumentException   If $allowedSyntax is not a list of NumberSyntax cases, or if $maxDigits is
 *                                    less than 1.
 *
 * @pure
 */";s:9:"startLine";i:223;s:7:"endLine";i:247;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:49;s:9:"namespace";s:10:"Brick\Math";s:18:"declaringClassName";s:20:"Brick\Math\BigNumber";s:21:"implementingClassName";s:20:"Brick\Math\BigNumber";s:16:"currentClassName";s:20:"Brick\Math\BigNumber";s:9:"aliasName";N;}s:3:"min";a:20:{s:4:"name";s:3:"min";s:10:"parameters";a:2:{s:1:"a";a:13:{s:4:"name";s:1:"a";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:20:"Brick\Math\BigNumber";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:265;s:7:"endLine";i:265;s:11:"startColumn";i:38;s:9:"endColumn";i:60;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:1:"n";a:13:{s:4:"name";s:1:"n";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:20:"Brick\Math\BigNumber";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:1;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:265;s:7:"endLine";i:265;s:11:"startColumn";i:63;s:9:"endColumn";i:88;s:14:"parameterIndex";i:1;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"static";s:12:"isIdentifier";b:0;}}s:10:"attributes";a:0:{}s:10:"docComment";s:728:"/**
 * Returns the minimum of the given values.
 *
 * If several values are equal and minimal, the first one is returned.
 * This can affect the concrete return type when calling this method on BigNumber.
 *
 * @param BigNumber|int|string $a    The first number. Must be convertible to an instance of the class this method
 *                                   is called on.
 * @param BigNumber|int|string ...$n The additional numbers. Each number must be convertible to an instance of the
 *                                   class this method is called on.
 *
 * @throws MathException If a number is not valid, or is not convertible to an instance of the class this method is
 *                       called on.
