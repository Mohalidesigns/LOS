 * Compute the intersection of one or more sorted sets storing the result in a new sorted set.
 *
 * @param string      $dst       The destination sorted set to store the intersected values.
 * @param array       $keys      One or more sorted set key names.
 * @param array|null  $weights   An optional array of floats to weight each passed input set.
 * @param string|null $aggregate An optional aggregation method to use.
 *                               'SUM' - Store sum of all intersected members (this is the default).
 *                               'MIN' - Store minimum value for each intersected member.
 *                               'MAX' - Store maximum value for each intersected member.
 *
 * @return Redis|int|false  The total number of members writtern to the destination set or false on failure.
 *
 * @see https://redis.io/docs/latest/commands/zinterstore/
 * @see https://redis.io/docs/latest/commands/zinter/
 *
 * @example
 * $redis->zAdd('zs1', 3, 'apples', 2, 'pears');
 * $redis->zAdd('zs2', 4, 'pears', 3, 'bananas');
 * $redis->zAdd('zs3', 2, 'figs', 3, 'pears');
 *
 * $redis->zInterStore('fruit-sum', ['zs1', 'zs2', 'zs3']);
 * $redis->zInterStore('fruit-max', ['zs1', 'zs2', 'zs3'], NULL, 'MAX');
 */";s:9:"startLine";i:5658;s:7:"endLine";i:5660;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:5:"zscan";a:20:{s:4:"name";s:5:"zscan";s:10:"parameters";a:4:{s:3:"key";a:13:{s:4:"name";s:3:"key";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:5690;s:7:"endLine";i:5690;s:11:"startColumn";i:31;s:9:"endColumn";i:41;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:8:"iterator";a:13:{s:4:"name";s:8:"iterator";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:1;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:5690;s:7:"endLine";i:5690;s:11:"startColumn";i:44;s:9:"endColumn";i:69;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:7:"pattern";a:13:{s:4:"name";s:7:"pattern";s:7:"default";a:2:{s:4:"code";s:5:"\null";s:10:"attributes";a:6:{s:9:"startLine";i:5690;s:7:"endLine";i:5690;s:13:"startTokenPos";i:10488;s:12:"startFilePos";i:246392;s:11:"endTokenPos";i:10488;s:10:"endFilePos";i:246395;}}s:4:"type";a:2:{s:5:"class";