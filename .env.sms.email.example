# Delivery credentials for the Fundly backend. Copy to .env.sms.email (gitignored)
# at the repository root; it is loaded before backend/.env and wins over it.
# Never loaded under tests. Check with: php artisan notifications:check-delivery

# SMTP relay. MAIL_MAILER=log writes mail to the log instead of sending.
MAIL_MAILER=log
MAIL_SCHEME=smtps            # smtps = TLS on 465; smtp = STARTTLS on 587 (MAIL_ENCRYPTION=ssl|tls also accepted)
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Fundly"
# Non-production: send every email to this inbox instead of the customer (ignored in production)
MAIL_ALWAYS_TO=

# SMS through the `sms` integration port. SMS_DRIVER=mock uses the simulator;
# hollatags sends for real. Apply the driver with: php artisan integration:bind-sms
SMS_ENABLED=false
SMS_DRIVER=mock
SMS_HOLLATAGS_USERNAME=
SMS_HOLLATAGS_PASSWORD=
SMS_HOLLATAGS_SENDER=        # sender ID, max 11 letters
SMS_DEFAULT_COUNTRY_CODE=234
# Non-production with a real gateway: every text goes to this handset; without it nothing is sent
SMS_ALWAYS_TO=
