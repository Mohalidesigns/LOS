<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Database">
            <directory>tests/Database</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="ARGON_MEMORY" value="1024"/>
        <env name="ARGON_TIME" value="1"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- PostgreSQL only. The runtime connection uses the non-owner role so RLS is real. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5433"/>
        <env name="DB_DATABASE" value="fundly_test"/>
        <env name="DB_USERNAME" value="fundly_app"/>
        <env name="DB_PASSWORD" value="app_dev_pw"/>
        <env name="DB_OWNER_USERNAME" value="fundly_owner"/>
        <env name="DB_OWNER_PASSWORD" value="owner_dev_pw"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="database"/>
        <env name="SESSION_COOKIE" value="fundly_session"/>
        <env name="SESSION_SECURE_COOKIE" value="false"/>
        <env name="SANCTUM_STATEFUL_DOMAINS" value="localhost"/>
        <env name="FUNDLY_INSTALLATION_ENV" value="non_production"/>
        <env name="FUNDLY_BREAKER_STORE" value="database"/>
        <env name="FUNDLY_KEK_PATH" value="storage/framework/testing/kek.key"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
