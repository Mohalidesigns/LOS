APP_NAME="Fundly LOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://los.bank.example
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter

# PostgreSQL 16+. Two roles (see deploy/sql/00-provision-roles.sql):
#  - DB_USERNAME: runtime role (non-owner, NOSUPERUSER, NOBYPASSRLS)
#  - DB_OWNER_USERNAME: schema owner, used by migrations only
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fundly
DB_USERNAME=fundly_app
DB_PASSWORD=
DB_OWNER_USERNAME=fundly_owner
DB_OWNER_PASSWORD=
DB_SSLMODE=prefer

# Sessions: database driver (concurrent-session cap, revocation on role change)
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_COOKIE=__Host-fundly_session
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Sanctum SPA (same-origin). Comma separated host[:port] list.
SANCTUM_STATEFUL_DOMAINS=los.bank.example
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Fundly platform
FUNDLY_INSTALLATION_ENV=production
FUNDLY_TENANCY_RESOLUTION=single
FUNDLY_MFA_REQUIRED=true
FUNDLY_SESSION_IDLE_MINUTES=15
FUNDLY_SESSION_ABSOLUTE_MINUTES=480
FUNDLY_SESSION_MAX_CONCURRENT=1
FUNDLY_STEP_UP_MINUTES=5
FUNDLY_BREAKER_STORE=redis
# Ed25519 vendor licence public key (base64). Pinned per installation.
FUNDLY_LICENCE_PUBLIC_KEY=
# Local keyfile KEK (MVP KeyManagementPort adapter); mount read-only, mode 0400.
FUNDLY_KEK_PATH=/run/secrets/fundly_kek
FUNDLY_KEK_ID=local-1
