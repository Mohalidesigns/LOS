 * Creates a BigNumber of the given value.
 *
 * When of() is called on BigNumber, the concrete return type is dependent on the given value, with the following
 * rules:
 *
 * - BigNumber instances are returned as is
 * - integer numbers are returned as BigInteger
 * - strings containing a `/` character are returned as BigRational
 * - strings containing a `.` character or using an exponential notation are returned as BigDecimal
 * - strings containing only digits with an optional leading `+` or `-` sign are returned as BigInteger
 *
 * When of() is called on BigInteger, BigDecimal, or BigRational, the resulting number is converted to an instance
 * of the subclass when possible; otherwise a RoundingNecessaryException is thrown.
 *
 * When parsing untrusted input, use {@see parse()} instead.
 *
 * @throws NumberFormatException      If the input is a string, and the format of the number is not valid.
 * @throws RoundingNecessaryException If the method is called on a subclass of BigNumber, and the value cannot be
 *                                    converted to an instance of the subclass without rounding.
 *
 * @pure
 */";s:9:"startLine";i:98;s:7:"endLine";i:108;s:11:"startColumn";i:5;s:9:"endColumn";i:5;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:49;s:9:"namespace";s:10:"Brick\Math";s:18:"declaringClassName";s:20:"Brick\Math\BigNumber";s:21:"implementingClassName";s:20:"Brick\Math\BigNumber";s:16:"currentClassName";s:20:"Brick\Math\BigNumber";s:9:"aliasName";N;}s:10:"ofNullable";a:20:{s:4:"name";s:10:"ofNullable";s:10:"parameters";a:1:{s:5:"value";a:13:{s:4:"name";s:5:"value";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:4:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:20:"Brick\Math\BigNumber";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}i:3;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:123;s:7:"endLine";i:123;s:11:"startColumn";i:45;s:9:"endColumn";i:76;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"static";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:545:"/**
 * Creates a BigNumber of the given value, or returns null if the input is null.
 *
 * Behaves like {@see of()} for non-null values.
 *
 * When parsing untrusted input, use {@see parseNullable()} instead.
