 * Subscribe to one or more Redis pubsub channels.
 *
 * @param array    $channels One or more channel names.
 * @param callable $cb       The callback PhpRedis will invoke when we receive a message
 *                           from one of the subscribed channels.
 *
 * @return bool True on success, false on faiilure.  Note that this command will block the
 *              client in a subscribe loop, waiting for messages to arrive.
 *
 * @see https://redis.io/docs/latest/commands/subscribe/
 *
 * @example
 * $redis = new Redis(['host' => 'localhost']);
 *
 * $redis->subscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) {
 *     echo "[$channel]: $message\n";
 *
 *     // Unsubscribe from the message channel when we read 'quit'
 *     if ($message == 'quit') {
 *         echo "Unsubscribing from '$channel'\n";
 *         $redis->unsubscribe([$channel]);
 *     }
 * });
 *
 * // Once we read 'quit' from both channel-1 and channel-2 the subscribe loop will be
 * // broken and this command will execute.
 * echo "Subscribe loop ended\n";
 */";s:9:"startLine";i:4166;s:7:"endLine";i:4168;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:12:"sunsubscribe";a:20:{s:4:"name";s:12:"sunsubscribe";s:10:"parameters";a:1:{s:8:"channels";a:13:{s:4:"name";s:8:"channels";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4191;s:7:"endLine";i:4191;s:11:"startColumn";i:38;s:9:"endColumn";i:52;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"Redis";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:717:"/**
 * Unsubscribes the client from the given shard channels,
 * or from all of them if none is given.
 *
 * @param array $channels One or more channels to unsubscribe from.
 * @return Redis|array|bool The array of unsubscribed channels.
 *
 * @see https://redis.io/docs/latest/commands/sunsubscribe/
 * @see Redis::ssubscribe()
 *
 * @example
 * $redis->ssubscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) {
 *     if ($message == 'quit') {
 *         echo "$channel => 'quit' detected, unsubscribing!\n";
 *         $redis->sunsubscribe([$channel]);
 *     } else {
 *         echo "$channel => $message\n";
 *     }
 * });
 *
 * echo "We've unsubscribed from both channels, exiting\n";
 */";s:9:"startLine";i:4191;s:7:"endLine";i:4193;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:6:"swapdb";a:20:{s:4:"name";s:6:"swapdb";s:10:"parameters";a:2:{s:3:"src";a:13:{s:4:"name";s:3:"src";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4215;s:7:"endLine";i:4215;s:11:"startColumn";i:32;s:9:"endColumn";i:39;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:3:"dst";a:13:{s:4:"name";s:3:"dst";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4215;s:7:"endLine";i:4215;s:11:"startColumn";i:42;s:9:"endColumn";i:49;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"Redis";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:709:"/**
 * Atomically swap two Redis databases so that all of the keys in the source database will
 * now be in the destination database and vice-versa.
 *
 * Note: This command simply swaps Redis' internal pointer to the database and is therefore
 * very fast, regardless of the size of the underlying databases.
 *
 * @param int $src The source database number
 * @param int $dst The destination database number
 *
 * @return Redis|bool Success if the databases could be swapped and false on failure.
 *
 * @see https://redis.io/docs/latest/commands/swapdb/
 * @see Redis::del()
 *
 * @example
 * $redis->select(0);
 * $redis->set('db0-key', 'db0-value');
 * $redis->swapdb(0, 1);
 * $redis->get('db0-key');
 */";s:9:"startLine";i:4215;s:7:"endLine";i:4217;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:4:"time";a:20:{s:4:"name";s:4:"time";s:10:"parameters";a:0:{}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"Redis";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:313:"/**
