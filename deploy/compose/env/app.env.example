# Copy to app.env and adjust. Non-secret settings only; secrets live in ../secrets/.
APP_NAME="Fundly LOS"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://los.bank.example
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_DATABASE=fundly
DB_USERNAME=fundly_app
DB_OWNER_USERNAME=fundly_owner
DB_SSLMODE=prefer
SESSION_DRIVER=database
SESSION_COOKIE=__Host-fundly_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict
SANCTUM_STATEFUL_DOMAINS=los.bank.example
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
FUNDLY_INSTALLATION_ENV=production
FUNDLY_TENANCY_RESOLUTION=single
FUNDLY_BREAKER_STORE=redis
FUNDLY_LICENCE_PUBLIC_KEY=
