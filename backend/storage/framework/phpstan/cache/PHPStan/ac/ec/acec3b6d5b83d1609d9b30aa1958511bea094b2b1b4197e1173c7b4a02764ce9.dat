 *
 * @return Redis|int|false The number of messages removed or false on failure.
 *
 * @see https://redis.io/docs/latest/commands/xdel/
 *
 * @example $redis->xDel('stream', ['1-1', '2-1', '3-1']);
 */";s:9:"startLine";i:4568;s:7:"endLine";i:4570;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:6:"xdelex";a:20:{s:4:"name";s:6:"xdelex";s:10:"parameters";a:3:{s:3:"key";a:13:{s:4:"name";s:3:"key";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4588;s:7:"endLine";i:4588;s:11:"startColumn";i:32;s:9:"endColumn";i:42;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:3:"ids";a:13:{s:4:"name";s:3:"ids";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4588;s:7:"endLine";i:4588;s:11:"startColumn";i:45;s:9:"endColumn";i:54;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:4:"mode";a:13:{s:4:"name";s:4:"mode";s:7:"default";a:2:{s:4:"code";s:5:"\null";s:10:"attributes";a:6:{s:9:"startLine";i:4588;s:7:"endLine";i:4588;s:13:"startTokenPos";i:8435;s:12:"startFilePos";i:193191;s:11:"endTokenPos";i:8435;s:10:"endFilePos";i:193194;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4588;s:7:"endLine";i:4588;s:11:"startColumn";i:57;s:9:"endColumn";i:76;s:14:"parameterIndex";i:2;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"Redis";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"false";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:619:"/**
 * Remove one or more IDs from a stream with extended options.
 *
 * @param string      $key  The stream to modify.
 * @param array       $ids  One or more message IDs to remove.
 * @param string|null $mode An optional mode argument.  Valid modes
 *                          are as follows: KEEPREF | DELREF | ACKED
 *
 * @return Redis|array|false An array corresponding to IDs. 1 if the id was
 *                           deleted and 0 if not.
 *
 * @see https://redis.io/docs/latest/commands/xdelex/
 *
 * @example
