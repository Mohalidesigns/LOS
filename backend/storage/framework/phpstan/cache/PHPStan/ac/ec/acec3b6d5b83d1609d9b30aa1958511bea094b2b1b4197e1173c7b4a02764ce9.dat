 * @example
 * $redis->pipeline()
 *       ->del('list1', 'list2')
 *       ->rpush('list1', 'list1-1', 'list1-2')
 *       ->rpush('list2', 'list2-1', 'list2-2')
 *       ->exec();
 *
 * $redis->rpoplpush('list2', 'list1');
 */";s:9:"startLine";i:3239;s:7:"endLine";i:3241;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:4:"sAdd";a:20:{s:4:"name";s:4:"sAdd";s:10:"parameters";a:3:{s:3:"key";a:13:{s:4:"name";s:3:"key";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:3259;s:7:"endLine";i:3259;s:11:"startColumn";i:30;s:9:"endColumn";i:40;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:5:"value";a:13:{s:4:"name";s:5:"value";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"mixed";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:3259;s:7:"endLine";i:3259;s:11:"startColumn";i:43;s:9:"endColumn";i:54;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}s:12:"other_values";a:13:{s:4:"name";s:12:"other_values";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"mixed";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:1;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:3259;s:7:"endLine";i:3259;s:11:"startColumn";i:57;s:9:"endColumn";i:78;s:14:"parameterIndex";i:2;s:10:"isOptional";b:1;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"Redis";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"false";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:477:"/**
 * Add one or more values to a Redis SET key.
 *
 * @param string $key         The key name
 * @param mixed  $value       A value to add to the set.
 * @param mixed $other_values One or more additional values to add
 *
 * @return Redis|int|false The number of values added to the set.
 *
 * @see https://redis.io/docs/latest/commands/sadd/
 *
 * @example
 * $redis->del('myset');
 *
