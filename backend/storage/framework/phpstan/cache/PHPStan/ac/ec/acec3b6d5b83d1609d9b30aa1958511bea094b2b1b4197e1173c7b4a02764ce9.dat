 * Scan the members of a redis SET key.
 *
 * @see https://redis.io/docs/latest/commands/sscan/
 * @see https://redis.io/docs/latest/commands/scan/
 * @see Redis::setOption()
 *
 * @param string          $key      The Redis SET key in question.
 * @param int|string|null $iterator A reference to an iterator which should be initialized to NULL that
 *                                  PhpRedis will update with the value returned from Redis after each
 *                                  subsequent call to SSCAN.  Once this cursor is zero you know all
 *                                  members have been traversed.
 * @param string|null     $pattern  An optional glob style pattern to match against, so Redis only
 *                                  returns the subset of members matching this pattern.
 * @param int             $count    A hint to Redis as to how many members it should scan in one command
 *                                  before returning members for that iteration.
 *
 * @example
 * $redis->del('myset');
 * for ($i = 0; $i < 10000; $i++) {
 *     $redis->sAdd('myset', "member:$i");
 * }
 * $redis->sadd('myset', 'foofoo');
 *
 * $redis->setOption(Redis::OPT_SCAN, Redis::SCAN_NORETRY);
 *
 * $scanned = 0;
 * $it = null;
 *
 * // Without Redis::SCAN_RETRY we may receive empty results and
 * // a nonzero iterator.
 * do {
 *     // Scan members containing '5'
 *     $members = $redis->sscan('myset', $it, '*5*');
 *     foreach ($members as $member) {
 *          echo "NORETRY: $member\n";
 *          $scanned++;
 *     }
 * } while ($it != 0);
 * echo "TOTAL: $scanned\n";
 *
 * $redis->setOption(Redis::OPT_SCAN, Redis::SCAN_RETRY);
 *
 * $scanned = 0;
 * $it = null;
 *
 * // With Redis::SCAN_RETRY PhpRedis will never return an empty array
 * // when the cursor is non-zero
 * while (($members = $redis->sscan('myset', $it, '*5*'))) {
 *     foreach ($members as $member) {
 *         echo "RETRY: $member\n";
 *         $scanned++;
 *     }
 * }
 */";s:9:"startLine";i:4087;s:7:"endLine";i:4089;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:10:"ssubscribe";a:20:{s:4:"name";s:10:"ssubscribe";s:10:"parameters";a:2:{s:8:"channels";a:13:{s:4:"name";s:8:"channels";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4119;s:7:"endLine";i:4119;s:11:"startColumn";i:36;s:9:"endColumn";i:50;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:2:"cb";a:13:{s:4:"name";s:2:"cb";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:8:"callable";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4119;s:7:"endLine";i:4119;s:11:"startColumn";i:53;s:9:"endColumn";i:64;s:14:"parameterIndex";i:1;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"bool";s:12:"isIdentifier";b:1;}}s:10:"attributes";a:0:{}s:10:"docComment";s:1087:"/**
 * Subscribes the client to the specified shard channels.
 *
 * @param array    $channels One or more channel names.
 * @param callable $cb       The callback PhpRedis will invoke when we receive a message
 *                           from one of the subscribed channels.
 *
 * @return bool True on success, false on faiilure.  Note that this command will block the
 *              client in a subscribe loop, waiting for messages to arrive.
 *
 * @see https://redis.io/docs/latest/commands/ssubscribe/
 *
 * @example
 * $redis = new Redis(['host' => 'localhost']);
 *
 * $redis->ssubscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) {
 *     echo "[$channel]: $message\n";
 *
 *     // Unsubscribe from the message channel when we read 'quit'
 *     if ($message == 'quit') {
 *         echo "Unsubscribing from '$channel'\n";
 *         $redis->sunsubscribe([$channel]);
 *     }
 * });
 *
 * // Once we read 'quit' from both channel-1 and channel-2 the subscribe loop will be
 * // broken and this command will execute.
 * echo "Subscribe loop ended\n";
 */";s:9:"startLine";i:4119;s:7:"endLine";i:4121;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:5:"Redis";s:21:"implementingClassName";s:5:"Redis";s:16:"currentClassName";s:5:"Redis";s:9:"aliasName";N;}s:6:"strlen";a:20:{s:4:"name";s:6:"strlen";s:10:"parameters";a:1:{s:3:"key";a:13:{s:4:"name";s:3:"key";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:4134;s:7:"endLine";i:4134;s:11:"startColumn";i:32;s:9:"endColumn";i:42;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:3:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"Redis";s:12:"isIdentifier";b:0;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:2;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"false";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:349:"/**
 * Retrieve the length of a Redis STRING key.
