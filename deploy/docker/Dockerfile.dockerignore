# Build context is the repository root; ship only what the image needs.
**
!backend/**
!deploy/docker/php/**
backend/vendor
backend/node_modules
backend/.env
backend/.env.*
!backend/.env.example
backend/storage/**/*
!backend/storage/**/.gitignore
backend/bootstrap/cache/*.php
backend/tests
backend/.phpunit.cache
backend/.phpunit.result.cache
